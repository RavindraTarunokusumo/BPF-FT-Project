{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpf-guardian.local/schemas/result.schema.json",
  "title": "BPF-Guardian validation result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "harness_version",
    "task_id",
    "candidate_id",
    "fingerprint",
    "decision",
    "stages",
    "cleanup"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "task_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["pass", "fail", "error", "skipped"]},
    "first_failed_stage": {
      "type": ["string", "null"],
      "enum": [null, "policy", "compiler", "verifier", "behavior", "cleanup", "infrastructure"]
    },
    "stages": {"type": "array", "minItems": 1},
    "cleanup": {
      "type": "object",
      "required": ["ok", "remaining_objects"],
      "properties": {
        "ok": {"type": "boolean"},
        "remaining_objects": {"type": "array"}
      }
    }
  }
}
