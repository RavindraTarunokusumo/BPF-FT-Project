{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpf-guardian.local/schemas/tests.schema.json",
  "title": "BPF-Guardian executable tests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "validators"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"},
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/validator"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": true,
      "required": ["case_id", "input", "expected"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"},
        "input": {"type": "object"},
        "expected": {"type": "object", "minProperties": 1}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "cases"],
      "properties": {
        "type": {
          "enum": ["packet_action", "packet_bytes", "map_state", "live_forward"]
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/case"}
        }
      }
    }
  }
}
