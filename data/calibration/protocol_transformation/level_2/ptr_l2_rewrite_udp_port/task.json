      "packet_hex": "525400123456525400654321080045000027123400004011e523c0a8010ac0a801143039007b00137728444e535f5041594c4f4144",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/rewrite_udp_123_to_5353_with_csum.bin",
