      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/ttl_2_dec.bin",
      "expected_bytes_hex": "5254001234565254006543210800450000271234000001112424c0a8010ac0a801143039003500130000444e535f5041594c4f4144"
