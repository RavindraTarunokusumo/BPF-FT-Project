      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/ttl_64_dec.bin",
      "expected_bytes_hex": "525400123456525400654321080045000028123400003f06e62dc0a8010ac0a8011430390050000003e8000000005002ffff00000000"
    },
    {
