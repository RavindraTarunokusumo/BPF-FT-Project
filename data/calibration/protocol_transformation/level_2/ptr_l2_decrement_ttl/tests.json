{
  "task_id": "ptr_l2_decrement_ttl",
  "validator": "packet_bytes",
  "test_count": 7,
  "tests": [
    {
      "name": "ttl_64_dec",
      "description": "IPv4 TTL 64 decremented to 63, checksum updated, returns XDP_PASS",
      "packet_hex": "525400123456525400654321080045000028123400004006e52dc0a8010ac0a8011430390050000003e8000000005002ffff00000000",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/ttl_64_dec.bin",
      "expected_bytes_hex": "525400123456525400654321080045000028123400003f06e62dc0a8010ac0a8011430390050000003e8000000005002ffff00000000"
    },
    {
      "name": "ttl_2_dec",
      "description": "IPv4 TTL 2 decremented to 1, checksum updated, returns XDP_PASS",
      "packet_hex": "5254001234565254006543210800450000271234000002112324c0a8010ac0a801143039003500130000444e535f5041594c4f4144",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/ttl_2_dec.bin",
      "expected_bytes_hex": "5254001234565254006543210800450000271234000001112424c0a8010ac0a801143039003500130000444e535f5041594c4f4144"
    },
    {
      "name": "ttl_1_drop",
      "description": "IPv4 TTL 1 must return XDP_DROP",
      "packet_hex": "525400123456525400654321080045000028123400000106242ec0a8010ac0a8011430390050000003e8000000005002ffff00000000",
      "expected_action": "XDP_DROP",
      "fixture_file": "fixtures/ttl_1_drop.bin"
    },
    {
      "name": "ttl_0_drop",
      "description": "IPv4 TTL 0 must return XDP_DROP",
      "packet_hex": "525400123456525400654321080045000028123400000006252ec0a8010ac0a8011430390050000003e8000000005002ffff00000000",
      "expected_action": "XDP_DROP",
      "fixture_file": "fixtures/ttl_0_drop.bin"
    },
    {
      "name": "arp_pass",
      "description": "ARP frame must return XDP_PASS unchanged",
      "packet_hex": "525400123456525400654321080600000000000000000000000000000000000000000000000000000000",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/arp_pass.bin",
      "expected_bytes_hex": "525400123456525400654321080600000000000000000000000000000000000000000000000000000000"
    },
    {
      "name": "ttl_255_dec",
      "description": "IPv4 TTL 255 decremented to 254",
      "packet_hex": "52540012345652540065432108004500002412340000ff012636c0a8010ac0a801140800e2d40000123450494e4731323334",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/ttl_255_dec.bin",
      "expected_bytes_hex": "52540012345652540065432108004500002412340000fe012736c0a8010ac0a801140800e2d40000123450494e4731323334"
    },
    {
      "name": "truncated_ip_pass",
      "description": "Truncated IP header returns XDP_PASS safely",
      "packet_hex": "52540012345652540065432108004500",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/truncated_ip_pass.bin"
    }
  ]
}