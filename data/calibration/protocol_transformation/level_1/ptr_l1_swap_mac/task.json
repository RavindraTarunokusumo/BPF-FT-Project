{
  "task_id": "ptr_l1_swap_mac",
  "application_category": "protocol_transformation",
  "difficulty": "level_1",
  "task_family": "xdp_packet_rewrite",
  "template_family": "xdp_l2_rewrite",
  "semantic_signature": "ethernet+swap_mac_addresses+pass",
  "split": "calibration",
  "learning_mode": "synthesis",
  "instruction": "Write a complete XDP/eBPF program that swaps Ethernet source and destination MAC addresses and passes the packet with XDP_PASS. Preserve every byte of the frame following the 12-byte MAC address area (EtherType, payload, etc.) exactly. If the packet is shorter than 14 bytes (runt Ethernet frame), return XDP_PASS unchanged.",
  "requirements": [
    "Check Ethernet header bounds",
    "Swap eth->h_dest and eth->h_source using byte-wise or multi-byte temporary variables",
    "Preserve EtherType and payload intact",
    "Return XDP_PASS for all frames",
    "GPL license and SEC(\"xdp\") entry point"
  ],
  "gold_candidate_id": null,
  "tests": [
