  "semantic_signature": "ipv4+icmp_echo_req+drop",
  "split": "calibration",
  "learning_mode": "synthesis",
  "instruction": "Write a complete XDP/eBPF program that drops IPv4 ICMP Echo Requests (Type 8). Pass other ICMP types, other protocols, non-IPv4, and malformed packets.",
  "requirements": [
    "Check Ethernet and IPv4 bounds",
    "Verify Ethernet protocol is ETH_P_IP (0x0800)",
    "Verify IP protocol is IPPROTO_ICMP",
    "Parse variable IHL (ip->ihl * 4) safely",
    "If ICMP type is 8 (Echo Request), return XDP_DROP; otherwise XDP_PASS",
    "GPL license and SEC(\"xdp\") entry point"
  ],
  "gold_candidate_id": null,
  "tests": [
