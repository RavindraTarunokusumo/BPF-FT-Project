  "template_family": "xdp_stateless_filter",
  "semantic_signature": "ipv4+udp_dport_53+drop",
  "split": "calibration",
  "learning_mode": "synthesis",
  "instruction": "Write a complete XDP/eBPF program that drops IPv4 UDP packets with destination port 53 (DNS). Pass all other traffic (TCP, other UDP ports, non-IPv4, and truncated packets).",
  "requirements": [
    "Check Ethernet and IPv4 bounds",
    "Verify Ethernet protocol is ETH_P_IP (0x0800)",
    "Verify IP protocol is IPPROTO_UDP",
    "Parse variable IHL (ip->ihl * 4) safely",
    "If UDP dport is 53 (bpf_htons(53)), return XDP_DROP; otherwise XDP_PASS",
    "GPL license and SEC(\"xdp\") entry point"
  ],
  "gold_candidate_id": null,
  "tests": [
