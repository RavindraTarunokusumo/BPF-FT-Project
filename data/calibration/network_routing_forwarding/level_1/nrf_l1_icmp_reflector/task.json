{
  "task_id": "nrf_l1_icmp_reflector",
  "application_category": "network_routing_forwarding",
  "difficulty": "level_1",
  "task_family": "xdp_l2_reflector",
  "template_family": "xdp_packet_reflector",
  "semantic_signature": "ipv4+icmp+swap_mac_and_tx",
  "split": "calibration",
  "learning_mode": "synthesis",
  "instruction": "Write a complete XDP/eBPF program that reflects valid IPv4 ICMP packets at Layer 2 by swapping Ethernet source and destination MAC addresses and returning XDP_TX. Pass all other traffic (TCP, UDP, other protocols, non-IPv4, and malformed frames) unchanged with XDP_PASS.",
  "requirements": [
    "Check Ethernet and IPv4 bounds",
    "Verify eth->h_proto == bpf_htons(ETH_P_IP)",
    "Verify ip->protocol == IPPROTO_ICMP",
    "Check ICMP header bounds",
    "Swap eth->h_source and eth->h_dest",
    "Return XDP_TX for ICMP packets, XDP_PASS for others",
    "GPL license and SEC(\"xdp\") entry point"
  ],
  "gold_candidate_id": null,
  "tests": [
    {
      "name": "icmp_echo_reflect_tx",
      "description": "ICMP Echo packet must swap MACs and return XDP_TX",
      "packet_hex": "123456789abcdef012345678080045000024123400004001e536c0a8010ac0a801140800e2d40000123450494e4731323334",
      "expected_action": "XDP_TX",
      "fixture_file": "fixtures/icmp_echo_reflect_tx.bin"
    },
    {
      "name": "icmp_reply_reflect_tx",
      "description": "ICMP Reply packet must swap MACs and return XDP_TX",
      "packet_hex": "123456789abcdef012345678080045000024123400004001e536c0a8010ac0a801140000ead40000123450494e4731323334",
      "expected_action": "XDP_TX",
      "fixture_file": "fixtures/icmp_reply_reflect_tx.bin"
    },
    {
      "name": "tcp_pass",
      "description": "TCP packet must return XDP_PASS",
      "packet_hex": "525400123456525400654321080045000028123400004006e52dc0a8010ac0a8011430390050000003e8000000005002ffff00000000",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/tcp_pass.bin"
    },
    {
      "name": "udp_pass",
      "description": "UDP packet must return XDP_PASS",
      "packet_hex": "525400123456525400654321080045000027123400004011e523c0a8010ac0a801143039003500130000444e535f5041594c4f4144",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/udp_pass.bin"
    },
    {
      "name": "arp_pass",
      "description": "ARP frame must return XDP_PASS",
      "packet_hex": "525400123456525400654321080600000000000000000000000000000000000000000000000000000000",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/arp_pass.bin"
    },
    {
      "name": "truncated_icmp_pass",
      "description": "Truncated ICMP header must return XDP_PASS safely",
      "packet_hex": "525400123456525400654321080045000014123400004001e546c0a8010ac0a80114",
      "expected_action": "XDP_PASS",
      "fixture_file": "fixtures/truncated_icmp_pass.bin"
    }
  ]
}